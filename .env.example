# Copia questo file in ".env" e compila i valori. Nessuna chiave va scritta nel codice.

# Endpoint del form contatti (Formspree, Web3Forms, funzione serverless, script PHP).
# Esempi:  https://formspree.io/f/xxxxxxx   |   https://api.web3forms.com/submit   |   /contact.php
# Vuoto = il form apre l'app di posta con il messaggio gia' scritto (mailto).
VITE_FORM_ENDPOINT=

# Formato di invio: form (application/x-www-form-urlencoded, default) oppure json
VITE_FORM_FORMAT=form

# Solo per Web3Forms: access key (e' pubblica per design, ma resta configurabile)
VITE_FORM_ACCESS_KEY=

# Cloudflare Turnstile (anti-spam), facoltativo: site key pubblica
VITE_TURNSTILE_SITEKEY=

# Statistica e marketing: si caricano SOLO dopo il consenso nel banner cookie.
# Se restano vuoti, il sito non usa cookie di terze parti e il banner non compare.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
